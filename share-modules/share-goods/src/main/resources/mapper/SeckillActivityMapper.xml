<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.share.goods.mapper.SeckillActivityMapper">

    <resultMap id="SeckillActivityResult" type="com.share.goods.domain.SeckillActivity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="productId" column="product_id"/>
        <result property="skuId" column="sku_id"/>
        <result property="seckillPrice" column="seckill_price"/>
        <result property="stock" column="stock"/>
        <result property="limitPerUser" column="limit_per_user"/>
        <result property="sort" column="sort"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
        <result property="productName" column="product_name"/>
        <result property="skuSpecs" column="sku_specs"/>
        <result property="mainImage" column="main_image"/>
    </resultMap>

    <sql id="selectSeckillActivityVo">
        SELECT a.*, p.name AS product_name, ps.specs AS sku_specs, p.main_image
        FROM seckill_activity a
        LEFT JOIN product p ON p.id = a.product_id
        LEFT JOIN product_sku ps ON ps.id = a.sku_id
    </sql>

    <select id="selectSeckillActivityList" parameterType="com.share.goods.domain.SeckillActivity"
            resultMap="SeckillActivityResult">
        <include refid="selectSeckillActivityVo"/>
        WHERE a.del_flag = '0'
        <if test="name != null and name != ''">
            AND a.name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="merchantId != null">
            AND a.merchant_id = #{merchantId}
        </if>
        <if test="productId != null">
            AND a.product_id = #{productId}
        </if>
        <if test="status != null and status != ''">
            AND a.status = #{status}
        </if>
        <if test="startTime != null">
            AND a.start_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND a.end_time &lt;= #{endTime}
        </if>
        ORDER BY a.sort DESC, a.create_time DESC
    </select>

    <select id="selectSeckillActivityById" parameterType="Long" resultMap="SeckillActivityResult">
        <include refid="selectSeckillActivityVo"/>
        WHERE a.id = #{id} AND a.del_flag = '0'
    </select>

</mapper>
